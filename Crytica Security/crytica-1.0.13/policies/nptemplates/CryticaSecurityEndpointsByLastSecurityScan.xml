<RULES>
    <RULE APP_VERSION="9.1.5-479" CACHE_TTL="259200" CACHE_TTL_SYNCED="true" CLASSIFICATION="REG_STATUS" DESCRIPTION="Classifies endpoints according to the age of their most recent Crytica Security scan evidence. Endpoints are grouped as having no Crytica Security scan data, scan evidence older than 30 days, scan evidence 7 to 30 days old, or scan evidence within the last 7 days." ENABLED="true" ID="-3195459333415290294" NAME="Crytica Security - Endpoints by Last Security Scan" NOT_COND_UPDATE="true" UPGRADE_PERFORMED="true">
