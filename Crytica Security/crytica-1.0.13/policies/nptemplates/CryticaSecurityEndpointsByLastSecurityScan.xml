            <INNER_RULE APP_VERSION="9.1.5-479" CACHE_TTL="259200" CACHE_TTL_SYNCED="true" CLASSIFICATION="REG_STATUS" DESCRIPTION="Identifies endpoints with Crytica Security scan evidence reported within the last 7 days. These endpoints meet the current scan-recency requirement." ID="-6364862151819097766" NAME="Crytica Security Last Scan 7 Days" NOT_COND_UPDATE="true" RECHECK_MAIN_RULE_DEF="true">
