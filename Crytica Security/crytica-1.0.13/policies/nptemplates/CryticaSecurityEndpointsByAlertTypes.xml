                    </CONDITION>
                </EXPRESSION>
            </INNER_RULE>
            <INNER_RULE APP_VERSION="9.1.5-479" CACHE_TTL="259200" CACHE_TTL_SYNCED="true" CLASSIFICATION="REG_STATUS" DESCRIPTION="Identifies endpoints with a Crytica Security Element Added alert, indicating that a new executable or monitored element was detected on the device. Use this classification to support investigation, reporting, and approved response workflows." ID="7493233267629953080" NAME="Crytica Security Alert Type Added" NOT_COND_UPDATE="true" RECHECK_MAIN_RULE_DEF="true">
