            <INNER_RULE APP_VERSION="9.1.5-479" CACHE_TTL="259200" CACHE_TTL_SYNCED="true" CLASSIFICATION="REG_STATUS" DESCRIPTION="Identifies endpoints with a Crytica Security Element Modified alert, indicating that the content or modification time of an executable or monitored element changed on the device. Use this classification to support investigation, reporting, and approved response workflows." ID="-6852102863659109745" NAME="Crytica Security Alert Type - Modified" NOT_COND_UPDATE="true" RECHECK_MAIN_RULE_DEF="true">
